--- a/misc/systemd/CMakeLists.txt
+++ b/misc/systemd/CMakeLists.txt
@@ -1,11 +1,8 @@
-if (NOT DEFINED SYSTEMD_SYSTEM_UNIT_DIR)
-    find_package(PkgConfig REQUIRED)
-    pkg_check_modules(Systemd REQUIRED systemd)
-    pkg_get_variable(SYSTEMD_SYSTEM_UNIT_DIR systemd systemdsystemunitdir)
-endif()
-
-if (NOT DEFINED SYSTEMD_USER_UNIT_DIR)
-    find_package(PkgConfig REQUIRED)
-    pkg_check_modules(Systemd REQUIRED systemd)
-    pkg_get_variable(SYSTEMD_USER_UNIT_DIR systemd systemduserunitdir)
-endif()
+# Debian forky has no systemd.pc. Use the standard unit paths directly so
+# install() always gets an explicit destination (CMake 4 rejects empty ones).
+if (NOT DEFINED SYSTEMD_SYSTEM_UNIT_DIR)
+    set(SYSTEMD_SYSTEM_UNIT_DIR "/usr/lib/systemd/system")
+endif()
+if (NOT DEFINED SYSTEMD_USER_UNIT_DIR)
+    set(SYSTEMD_USER_UNIT_DIR "/usr/lib/systemd/user")
+endif()
