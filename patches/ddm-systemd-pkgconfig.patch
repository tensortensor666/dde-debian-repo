--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -64,7 +64,8 @@
 # PAM
 pkg_search_module(Pam REQUIRED IMPORTED_TARGET pam)
 
 # Systemd
-pkg_search_module(Systemd REQUIRED IMPORTED_TARGET systemd)
+# Debian forky no longer ships systemd.pc; libsystemd.pc is enough for us.
+pkg_search_module(Systemd QUIET IMPORTED_TARGET systemd)
 
 # libsystemd
@@ -97,11 +98,23 @@
-if (NOT DEFINED SYSTEMD_SYSTEM_UNIT_DIR)
-    pkg_get_variable(SYSTEMD_SYSTEM_UNIT_DIR systemd systemdsystemunitdir)
-endif()
-
-if (NOT DEFINED SYSTEMD_SYSUSERS_DIR)
-    pkg_get_variable(SYSTEMD_SYSUSERS_DIR systemd sysusersdir)
-endif()
-
-if (NOT DEFINED SYSTEMD_TMPFILES_DIR)
-    pkg_get_variable(SYSTEMD_TMPFILES_DIR systemd tmpfilesdir)
-endif()
+if (TARGET PkgConfig::Systemd)
+    if (NOT DEFINED SYSTEMD_SYSTEM_UNIT_DIR)
+        pkg_get_variable(SYSTEMD_SYSTEM_UNIT_DIR systemd systemdsystemunitdir)
+    endif()
+    if (NOT DEFINED SYSTEMD_SYSUSERS_DIR)
+        pkg_get_variable(SYSTEMD_SYSUSERS_DIR systemd sysusersdir)
+    endif()
+    if (NOT DEFINED SYSTEMD_TMPFILES_DIR)
+        pkg_get_variable(SYSTEMD_TMPFILES_DIR systemd tmpfilesdir)
+    endif()
+endif()
+
+# Without systemd.pc, install() needs explicit destinations (CMake 4 rejects
+# empty ones). Standard Debian systemd paths, matching debian/ddm.install.
+if (NOT SYSTEMD_SYSTEM_UNIT_DIR)
+    set(SYSTEMD_SYSTEM_UNIT_DIR "/usr/lib/systemd/system")
+endif()
+if (NOT SYSTEMD_SYSUSERS_DIR)
+    set(SYSTEMD_SYSUSERS_DIR "/usr/lib/sysusers.d")
+endif()
+if (NOT SYSTEMD_TMPFILES_DIR)
+    set(SYSTEMD_TMPFILES_DIR "/usr/lib/tmpfiles.d")
+endif()
