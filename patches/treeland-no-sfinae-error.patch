-export DEB_CXXFLAGS_MAINT_APPEND = -Wall -Wextra -Werror -Wno-error=stringop-overflow
+export DEB_CFLAGS_MAINT_APPEND  = -Wall -Wextra -Werror -Wno-error=stringop-overflow -Wno-error=sfinae-incomplete
