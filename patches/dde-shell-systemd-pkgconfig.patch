diff --git a/CMakeLists.txt b/CMakeLists.txt
index 57760c6..49add49 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -18,7 +18,9 @@ endif ()
 
 set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
-add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:-Werror>)
+# Qt 6.11 deprecates QSortFilterProxyModel::invalidateFilter(); keep the
+# project's -Werror but don't fail on deprecated APIs from the newer Qt.
+add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:-Werror> $<$<COMPILE_LANGUAGE:CXX>:-Wno-error=deprecated-declarations>)
 set(CMAKE_AUTORCC ON)
 set(CMAKE_AUTOMOC ON)
 set(CMAKE_INCLUDE_CURRENT_DIR ON)
